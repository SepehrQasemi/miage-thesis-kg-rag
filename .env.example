# Local filesystem paths. Leave empty to use the default data/ layout.
# Neo4j stores metadata and graph state; the filesystem stores PDFs, exports, reports, and staged upload files.
MIAGE_DATA_DIR=
MIAGE_RAW_PDF_DIR=
MIAGE_PROCESSED_DIR=
MIAGE_GRAPH_DIR=
MIAGE_REPORTS_DIR=
MIAGE_CACHE_DIR=
MIAGE_STAGING_DIR=

# Required Neo4j graph database.
MIAGE_NEO4J_URI=bolt://127.0.0.1:7687
MIAGE_NEO4J_USER=neo4j
MIAGE_NEO4J_PASSWORD=miage-rag-2026
MIAGE_NEO4J_DATABASE=

# Import extraction.
# Set to 0 to disable OCR during PDF imports.
MIAGE_IMPORT_OCR=1
# Maximum accepted PDF upload size in MB.
MIAGE_MAX_UPLOAD_MB=100

# Optional local LLM suggestions for the Import PDF review screen.
# No paid API is required.
MIAGE_OLLAMA_MODEL=qwen2.5:7b
MIAGE_OLLAMA_URL=http://127.0.0.1:11434/api/generate
MIAGE_OLLAMA_TIMEOUT=90
